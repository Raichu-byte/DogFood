datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  VISITOR
  PARTICIPANT
  JUDGE
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  ACTIVE
  JUDGING
  VOTING
  FINALIZED
  PUBLISHED
}

enum TeamRole {
  LEADER
  MEMBER
}

enum AssignmentStatus {
  PENDING
  COMPLETED
}

enum JoinRequestType {
  APPLICATION
  INVITATION
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String
  role             Role              @default(PARTICIPANT)
  bio              String?
  githubUsername   String?
  portfolioUrl     String?
  skills           String?           // Stored as JSON array string: ["Rust", "React", ...]
  lookingForTeam   Boolean           @default(true)
  rolesSeeking     String?           // Stored as JSON array string: ["Frontend", "Backend"]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  createdEvents    Event[]           @relation("CreatedEvents")
  createdTeams     Team[]            @relation("CreatedTeams")
  teamMemberships  TeamMember[]
  judgeAssignments JudgeAssignment[]
  communityVotes   CommunityVote[]
  auditLogs        AuditLog[]
  comments         Comment[]
  announcements    Announcement[]
  joinRequests     JoinRequest[]     @relation("UserJoinRequests")
  notifications    Notification[]

  @@map("users")
}

model Event {
  id                 String            @id @default(cuid())
  name               String
  slug               String            @unique
  description        String
  status             EventStatus       @default(ACTIVE)
  submissionDeadline DateTime
  judgingDeadline    DateTime
  votingDeadline     DateTime
  organizerId        String
  organizer          User              @relation("CreatedEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tracks             Track[]
  prizes             Prize[]
  rubricCriteria     RubricCriteria[]
  teams              Team[]
  submissions        Submission[]
  judgeAssignments   JudgeAssignment[]
  communityVotes     CommunityVote[]
  auditLogs          AuditLog[]
  announcements      Announcement[]

  @@map("events")
}

model Track {
  id          String       @id @default(cuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String
  submissions Submission[]
  prizes      Prize[]

  @@map("tracks")
}

model Prize {
  id                  String      @id @default(cuid())
  eventId             String
  event               Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  trackId             String?
  track               Track?      @relation(fields: [trackId], references: [id], onDelete: SetNull)
  title               String
  amount              String
  description         String?
  winningSubmissionId String?
  winningSubmission   Submission? @relation("WonPrizes", fields: [winningSubmissionId], references: [id], onDelete: SetNull)

  @@map("prizes")
}

model Team {
  id                  String        @id @default(cuid())
  eventId             String
  event               Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name                String
  inviteCode          String        @unique
  creatorId           String
  creator             User          @relation("CreatedTeams", fields: [creatorId], references: [id], onDelete: Cascade)
  description         String?
  isLookingForMembers Boolean       @default(true)
  skillsNeeded        String?       // Stored as JSON array string: ["Solidity", "Design"]
  openRoles           String?       // Stored as JSON array string: ["Smart Contract Dev", "UI Designer"]
  maxMembers          Int           @default(5)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  members             TeamMember[]
  submission          Submission?
  joinRequests        JoinRequest[]

  @@unique([eventId, name])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  @@unique([teamId, userId])
  @@map("team_members")
}

model Submission {
  id               String               @id @default(cuid())
  eventId          String
  event            Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamId           String               @unique
  team             Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  trackId          String?
  track            Track?               @relation(fields: [trackId], references: [id], onDelete: SetNull)
  title            String
  tagline          String
  description      String
  techStack        String               // Stored as JSON array string: ["React", "Express", ...]
  repoUrl          String?
  demoUrl          String?
  videoUrl         String?
  thumbnailUrl     String?
  isDraft          Boolean              @default(true)
  submittedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  judgeAssignments JudgeAssignment[]
  communityVotes   CommunityVote[]
  scoreSummary     ProjectScoreSummary?
  abuseFlags       AbuseFlag[]
  wonPrizes        Prize[]              @relation("WonPrizes")
  comments         Comment[]

  @@map("submissions")
}

model RubricCriteria {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String
  weight      Float    // e.g. 0.25 (sum of all criteria weights should be 1.0)
  minScore    Float    @default(1.0)
  maxScore    Float    @default(10.0)
  createdAt   DateTime @default(now())

  scores      Score[]

  @@map("rubric_criteria")
}

model JudgeAssignment {
  id           String           @id @default(cuid())
  eventId      String
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judgeId      String
  judge        User             @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  submissionId String
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  status       AssignmentStatus @default(PENDING)
  assignedAt   DateTime         @default(now())

  scores       Score[]

  @@unique([judgeId, submissionId])
  @@map("judge_assignments")
}

model Score {
  id           String          @id @default(cuid())
  assignmentId String
  assignment   JudgeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criteriaId   String
  criteria     RubricCriteria  @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  scoreValue   Float
  feedback     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([assignmentId, criteriaId])
  @@map("scores")
}

model ProjectScoreSummary {
  id                  String     @id @default(cuid())
  submissionId        String     @unique
  submission          Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  rawScoreMean        Float      @default(0.0)
  normalizedZScore    Float      @default(0.0)
  communityVotesCount Int        @default(0)
  rank                Int?
  updatedAt           DateTime   @updatedAt

  @@map("project_score_summaries")
}

model CommunityVote {
  id           String     @id @default(cuid())
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  voterId      String
  voter        User       @relation(fields: [voterId], references: [id], onDelete: Cascade)
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([eventId, voterId])
  @@map("community_votes")
}

model AuditLog {
  id             String   @id @default(cuid())
  eventId        String?
  event          Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  actorId        String?
  actor          User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  targetResource String
  targetId       String?
  ipAddress      String?
  userAgent      String?
  metadata       String?  // JSON string
  timestamp      DateTime @default(now())

  @@map("audit_logs")
}

model AbuseFlag {
  id           String      @id @default(cuid())
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  flagType     String      // "DUPLICATE_SUBMISSION", "SUSPICIOUS_VOTING"
  severity     String      // "LOW", "MEDIUM", "HIGH"
  reason       String
  resolved     Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@map("abuse_flags")
}

model Comment {
  id           String      @id @default(cuid())
  submissionId String
  submission   Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       Comment?    @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]   @relation("CommentReplies")
  content      String
  isEdited     Boolean     @default(false)
  isPinned     Boolean     @default(false)
  isDeleted    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([submissionId])
  @@index([parentId])
  @@map("comments")
}

model Announcement {
  id             String    @id @default(cuid())
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId       String
  author         User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title          String
  content        String
  priority       String    @default("INFO") // "INFO", "IMPORTANT", "CRITICAL_ALERT"
  targetAudience String    @default("ALL")  // "ALL", "ORGANIZERS_ONLY", "JUDGES_ONLY", "PARTICIPANTS_ONLY"
  isPinned       Boolean   @default(false)
  isBannerActive Boolean   @default(false)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([eventId])
  @@index([priority])
  @@index([isBannerActive])
  @@map("announcements")
}

model JoinRequest {
  id        String          @id @default(cuid())
  teamId    String
  team      Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation("UserJoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  type      JoinRequestType @default(APPLICATION)
  status    RequestStatus   @default(PENDING)
  message   String?
  role      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([teamId])
  @@index([userId])
  @@map("join_requests")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // "ANNOUNCEMENT", "TEAM_INVITE", "JOIN_REQUEST", "COMMENT_REPLY", "SUBMISSION_UPDATE", "SYSTEM"
  title     String
  message   String
  link      String?
  isRead    Boolean   @default(false)
  metadata  String?   // JSON string
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}


