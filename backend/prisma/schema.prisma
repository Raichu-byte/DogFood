datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  VISITOR
  PARTICIPANT
  JUDGE
  MENTOR
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  ACTIVE
  JUDGING
  VOTING
  FINALIZED
  PUBLISHED
}

enum TeamRole {
  LEADER
  MEMBER
}

enum AssignmentStatus {
  PENDING
  COMPLETED
}

enum JoinRequestType {
  APPLICATION
  INVITATION
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String
  role             Role              @default(PARTICIPANT)
  bio              String?
  githubUsername   String?
  portfolioUrl     String?
  skills           String?           // Stored as JSON array string: ["Rust", "React", ...]
  lookingForTeam   Boolean           @default(true)
  rolesSeeking     String?           // Stored as JSON array string: ["Frontend", "Backend"]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  createdEvents       Event[]           @relation("CreatedEvents")
  createdTeams        Team[]            @relation("CreatedTeams")
  teamMemberships     TeamMember[]
  judgeAssignments    JudgeAssignment[]
  communityVotes      CommunityVote[]
  auditLogs           AuditLog[]
  comments            Comment[]
  announcements       Announcement[]
  joinRequests        JoinRequest[]     @relation("UserJoinRequests")
  notifications       Notification[]
  reputationScore     Int               @default(0)
  userBadges          UserBadge[]
  sentEndorsements    Endorsement[]     @relation("SentEndorsements")
  receivedEndorsements Endorsement[]    @relation("ReceivedEndorsements")
  reputationLogs      ReputationLog[]
  mentorProfile       MentorProfile?
  createdTickets      SupportTicket[]   @relation("CreatedTickets")
  claimedTickets      SupportTicket[]   @relation("ClaimedTickets")
  officeHourSlots     OfficeHourSlot[]  @relation("MentorOfficeHours")
  bookedOfficeHours   OfficeHourSlot[]  @relation("BookedOfficeHours")
  createdBounties     Bounty[]          @relation("CreatedBounties")
  bountySubmissions   BountySubmission[] @relation("UserBountySubmissions")

  @@map("users")
}

model Event {
  id                 String            @id @default(cuid())
  name               String
  slug               String            @unique
  description        String
  status             EventStatus       @default(ACTIVE)
  submissionDeadline DateTime
  judgingDeadline    DateTime
  votingDeadline     DateTime
  organizerId        String
  organizer          User              @relation("CreatedEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tracks             Track[]
  prizes             Prize[]
  rubricCriteria     RubricCriteria[]
  teams              Team[]
  submissions        Submission[]
  judgeAssignments   JudgeAssignment[]
  communityVotes     CommunityVote[]
  auditLogs          AuditLog[]
  announcements      Announcement[]
  supportTickets     SupportTicket[]
  officeHourSlots    OfficeHourSlot[]
  bounties           Bounty[]

  @@map("events")
}

model Track {
  id          String       @id @default(cuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String
  submissions Submission[]
  prizes      Prize[]

  @@map("tracks")
}

model Prize {
  id                  String      @id @default(cuid())
  eventId             String
  event               Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  trackId             String?
  track               Track?      @relation(fields: [trackId], references: [id], onDelete: SetNull)
  title               String
  amount              String
  description         String?
  winningSubmissionId String?
  winningSubmission   Submission? @relation("WonPrizes", fields: [winningSubmissionId], references: [id], onDelete: SetNull)

  @@map("prizes")
}

model Team {
  id                  String        @id @default(cuid())
  eventId             String
  event               Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name                String
  inviteCode          String        @unique
  creatorId           String
  creator             User          @relation("CreatedTeams", fields: [creatorId], references: [id], onDelete: Cascade)
  description         String?
  isLookingForMembers Boolean       @default(true)
  skillsNeeded        String?       // Stored as JSON array string: ["Solidity", "Design"]
  openRoles           String?       // Stored as JSON array string: ["Smart Contract Dev", "UI Designer"]
  maxMembers          Int           @default(5)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  members             TeamMember[]
  submission          Submission?
  joinRequests        JoinRequest[]
  supportTickets      SupportTicket[]
  bountySubmissions   BountySubmission[]

  @@unique([eventId, name])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  @@unique([teamId, userId])
  @@map("team_members")
}

model Submission {
  id               String               @id @default(cuid())
  eventId          String
  event            Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamId           String               @unique
  team             Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  trackId          String?
  track            Track?               @relation(fields: [trackId], references: [id], onDelete: SetNull)
  title            String
  tagline          String
  description      String
  techStack        String               // Stored as JSON array string: ["React", "Express", ...]
  repoUrl          String?
  demoUrl          String?
  videoUrl         String?
  thumbnailUrl     String?
  isDraft          Boolean              @default(true)
  submittedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  judgeAssignments JudgeAssignment[]
  communityVotes   CommunityVote[]
  scoreSummary     ProjectScoreSummary?
  abuseFlags       AbuseFlag[]
  wonPrizes        Prize[]              @relation("WonPrizes")
  comments         Comment[]

  @@map("submissions")
}

model RubricCriteria {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String
  weight      Float    // e.g. 0.25 (sum of all criteria weights should be 1.0)
  minScore    Float    @default(1.0)
  maxScore    Float    @default(10.0)
  createdAt   DateTime @default(now())

  scores      Score[]

  @@map("rubric_criteria")
}

model JudgeAssignment {
  id           String           @id @default(cuid())
  eventId      String
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judgeId      String
  judge        User             @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  submissionId String
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  status       AssignmentStatus @default(PENDING)
  assignedAt   DateTime         @default(now())

  scores       Score[]

  @@unique([judgeId, submissionId])
  @@map("judge_assignments")
}

model Score {
  id           String          @id @default(cuid())
  assignmentId String
  assignment   JudgeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criteriaId   String
  criteria     RubricCriteria  @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  scoreValue   Float
  feedback     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([assignmentId, criteriaId])
  @@map("scores")
}

model ProjectScoreSummary {
  id                  String     @id @default(cuid())
  submissionId        String     @unique
  submission          Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  rawScoreMean        Float      @default(0.0)
  normalizedZScore    Float      @default(0.0)
  communityVotesCount Int        @default(0)
  rank                Int?
  updatedAt           DateTime   @updatedAt

  @@map("project_score_summaries")
}

model CommunityVote {
  id           String     @id @default(cuid())
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  voterId      String
  voter        User       @relation(fields: [voterId], references: [id], onDelete: Cascade)
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([eventId, voterId])
  @@map("community_votes")
}

model AuditLog {
  id             String   @id @default(cuid())
  eventId        String?
  event          Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  actorId        String?
  actor          User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  targetResource String
  targetId       String?
  ipAddress      String?
  userAgent      String?
  metadata       String?  // JSON string
  timestamp      DateTime @default(now())

  @@map("audit_logs")
}

model AbuseFlag {
  id           String      @id @default(cuid())
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  flagType     String      // "DUPLICATE_SUBMISSION", "SUSPICIOUS_VOTING"
  severity     String      // "LOW", "MEDIUM", "HIGH"
  reason       String
  resolved     Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@map("abuse_flags")
}

model Comment {
  id           String      @id @default(cuid())
  submissionId String
  submission   Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       Comment?    @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]   @relation("CommentReplies")
  content      String
  isEdited     Boolean     @default(false)
  isPinned     Boolean     @default(false)
  isDeleted    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([submissionId])
  @@index([parentId])
  @@map("comments")
}

model Announcement {
  id             String    @id @default(cuid())
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId       String
  author         User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title          String
  content        String
  priority       String    @default("INFO") // "INFO", "IMPORTANT", "CRITICAL_ALERT"
  targetAudience String    @default("ALL")  // "ALL", "ORGANIZERS_ONLY", "JUDGES_ONLY", "PARTICIPANTS_ONLY"
  isPinned       Boolean   @default(false)
  isBannerActive Boolean   @default(false)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([eventId])
  @@index([priority])
  @@index([isBannerActive])
  @@map("announcements")
}

model JoinRequest {
  id        String          @id @default(cuid())
  teamId    String
  team      Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation("UserJoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  type      JoinRequestType @default(APPLICATION)
  status    RequestStatus   @default(PENDING)
  message   String?
  role      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([teamId])
  @@index([userId])
  @@map("join_requests")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // "ANNOUNCEMENT", "TEAM_INVITE", "JOIN_REQUEST", "COMMENT_REPLY", "SUBMISSION_UPDATE", "SYSTEM"
  title     String
  message   String
  link      String?
  isRead    Boolean   @default(false)
  metadata  String?   // JSON string
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  icon        String      // Lucide icon name or emoji: e.g. "Award", "Zap", "Shield", "Trophy"
  category    String      @default("ACHIEVEMENT") // "ACHIEVEMENT", "COMMUNITY", "SPECIALTY", "JUDGING"
  tier        String      @default("BRONZE")      // "BRONZE", "SILVER", "GOLD", "PLATINUM", "SPECIAL"
  points      Int         @default(10)
  createdAt   DateTime    @default(now())

  userBadges  UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedBy String?  @default("SYSTEM")
  metadata  String?  // JSON string
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@map("user_badges")
}

model Endorsement {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentEndorsements", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedEndorsements", fields: [receiverId], references: [id], onDelete: Cascade)
  skill      String
  weight     Int      @default(1)
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([senderId, receiverId, skill])
  @@index([senderId])
  @@index([receiverId])
  @@index([skill])
  @@map("endorsements")
}

model ReputationLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points      Int
  action      String   // "PROJECT_SUBMITTED", "PODIUM_VICTORY", "COMMUNITY_VOTE", "PEER_ENDORSEMENT", "JUDGE_EVALUATION", "BADGE_EARNED"
  sourceId    String?
  description String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("reputation_logs")
}

model MentorProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expertise           String   // Stored as JSON array string: ["Rust", "AI", "Distributed Systems"]
  bio                 String?
  company             String?
  status              String   @default("AVAILABLE") // "AVAILABLE", "BUSY", "OFFLINE"
  location            String?  // e.g. "Mentor Table 3" or "Discord #mentor-channel"
  maxConcurrentTickets Int     @default(3)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("mentor_profiles")
}

model SupportTicket {
  id               String    @id @default(cuid())
  eventId          String
  event            Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamId           String?
  team             Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  creatorId        String
  creator          User      @relation("CreatedTickets", fields: [creatorId], references: [id], onDelete: Cascade)
  mentorId         String?
  mentor           User?     @relation("ClaimedTickets", fields: [mentorId], references: [id], onDelete: SetNull)
  title            String
  description      String
  category         String    @default("DEBUGGING") // "DEBUGGING", "ARCHITECTURE", "API_HELP", "PITCH_PREP", "GENERAL"
  priority         String    @default("NORMAL")    // "LOW", "NORMAL", "HIGH", "URGENT"
  status           String    @default("OPEN")      // "OPEN", "CLAIMED", "IN_PROGRESS", "RESOLVED", "CANCELLED"
  location         String?   // e.g. "Table 12"
  resolutionNotes  String?
  claimedAt        DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([eventId])
  @@index([creatorId])
  @@index([mentorId])
  @@index([status])
  @@map("support_tickets")
}

model OfficeHourSlot {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  mentorId    String
  mentor      User     @relation("MentorOfficeHours", fields: [mentorId], references: [id], onDelete: Cascade)
  bookedById  String?
  bookedBy    User?    @relation("BookedOfficeHours", fields: [bookedById], references: [id], onDelete: SetNull)
  topic       String
  startTime   DateTime
  endTime     DateTime
  location    String?
  status      String   @default("OPEN") // "OPEN", "BOOKED", "COMPLETED", "CANCELLED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId])
  @@index([mentorId])
  @@index([bookedById])
  @@index([status])
  @@map("office_hour_slots")
}

model Bounty {
  id                  String             @id @default(cuid())
  eventId             String
  event               Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creatorId           String
  creator             User               @relation("CreatedBounties", fields: [creatorId], references: [id], onDelete: Cascade)
  title               String
  description         String
  rewardAmount        String             // e.g. "$1,500 USDC" or "500 DOGFOOD"
  category            String             @default("FEATURE") // "FEATURE", "BUG_HUNT", "INTEGRATION", "DESIGN", "DOCS"
  sponsorName         String?
  sponsorLogo         String?
  requirements        String?            // JSON or text requirements
  status              String             @default("OPEN") // "OPEN", "IN_REVIEW", "AWARDED", "CLOSED"
  deadline            DateTime?
  winnerSubmissionId  String?
  winnerSubmission    BountySubmission?  @relation("WonBounty", fields: [winnerSubmissionId], references: [id], onDelete: SetNull)
  submissions         BountySubmission[] @relation("BountySubmissions")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([eventId])
  @@index([creatorId])
  @@index([status])
  @@map("bounties")
}

model BountySubmission {
  id          String    @id @default(cuid())
  bountyId    String
  bounty      Bounty    @relation("BountySubmissions", fields: [bountyId], references: [id], onDelete: Cascade)
  submitterId String
  submitter   User      @relation("UserBountySubmissions", fields: [submitterId], references: [id], onDelete: Cascade)
  teamId      String?
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  title       String
  description String
  proofUrl    String    // PR link, commit, or demo URL
  status      String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  feedback    String?
  wonBounties Bounty[]  @relation("WonBounty")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([bountyId, submitterId])
  @@index([bountyId])
  @@index([submitterId])
  @@index([status])
  @@map("bounty_submissions")
}





