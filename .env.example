# Dogfood 2026 Platform Environment Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL 16)
# Local host default:
DATABASE_URL=postgresql://rachnakumari@localhost:5432/dogfood?schema=public
# Docker Compose default:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/dogfood?schema=public

# Test Database URL
TEST_DATABASE_URL=postgresql://rachnakumari@localhost:5432/dogfood_test?schema=public

# Security & JWT Secrets
JWT_SECRET=dogfood_dev_insecure_jwt_secret_change_in_production_2026
JWT_EXPIRES_IN=24h

# File Uploads Directory
UPLOAD_DIR=./uploads

# Client Origin
CLIENT_URL=http://localhost:5173
