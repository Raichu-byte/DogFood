# ==========================================
# DOGFOOD 2026 - Production .gitignore
# ==========================================

# Node.js & Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
build/
out/
.next/
.nuxt/
.cache/
coverage/
.nyc_output/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
vite.log

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configurations
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp

# Docker & Database Data Directories
postgres_data/
*.sqlite
*.sqlite3
*.db
*.db-journal

# Prisma Local SQLite / Generated Artifacts
backend/prisma/*.db
backend/prisma/*.db-journal

# Local Uploads & Static Media (Keep placeholder)
backend/uploads/*
!backend/uploads/.gitkeep
frontend/public/uploads/*
!frontend/public/uploads/.gitkeep

# Testing & Coverage Artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Temporary / Scratch Files
tmp/
temp/
scratch/
*.tmp
