{
  "name": "dogfood-2026",
  "version": "1.0.0",
  "private": true,
  "description": "Dogfood 2026 — Self-Hostable Hackathon Management Platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build:frontend": "npm --workspace=frontend run build",
    "build": "npm --workspace=frontend run build",
    "prisma:generate": "npm --workspace=backend run prisma:generate",
    "prisma:migrate": "npm --workspace=backend run prisma:migrate",
    "prisma:seed": "npm --workspace=backend run prisma:seed",
    "test": "npm --workspace=backend test",
    "test:unit": "npm --workspace=backend run test:unit",
    "test:api": "npm --workspace=backend run test:api",
    "test:acceptance": "npm --workspace=backend run test:acceptance"
  }
}
